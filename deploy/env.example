# Compose interpolation. On the VPS: cp deploy/env.example .env (mode 600). No app secrets here.
AWT_IMAGE=ghcr.io/OWNER/awt
# Moving tag the deploy agent (deploy/agent.sh) follows; CI pushes it from the
# branch of the same name.
AWT_CHANNEL=rewrite-go
AWT_PROD_HOST=www.example.org
AWT_TRAINING_HOST=training.example.org
# Image tags are rewritten by deploy/deploy.sh (none = nothing deployed yet).
AWT_PROD_TAG=none
AWT_TRAINING_TAG=none
