# On the VPS: cp deploy/env.training.example .env.training (mode 600). Never commit the real file.
# Use a different bucket (or credentials) than prod.
AWT_ENV=training
# Required outside dev: public URL of the site (CDN purge URLs).
AWT_BASE_URL=https://training.example.org
AWT_TRUSTED_PROXIES=172.30.0.0/24
AWT_CLIENT_IP_HEADER=CF-Connecting-IP

# Litestream replicates to litestream/training/ in this bucket.
# Leave AWT_S3_BUCKET empty to disable replication.
AWT_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
AWT_S3_BUCKET=awt-training
AWT_S3_ACCESS_KEY=
AWT_S3_SECRET_KEY=
LITESTREAM_S3_REGION=gra
AWT_BLOB_BACKEND=s3
