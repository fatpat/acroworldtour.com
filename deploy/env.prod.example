# On the VPS: cp deploy/env.prod.example .env.prod (mode 600). Never commit the real file.
AWT_ENV=prod
# Required outside dev: public URL of the site (CDN purge URLs).
AWT_BASE_URL=https://www.example.org
# Caddy's network (fixed in compose.yaml) and the header Cloudflare sets.
AWT_TRUSTED_PROXIES=172.30.0.0/24
AWT_CLIENT_IP_HEADER=CF-Connecting-IP

# OVHcloud Object Storage (S3 API). Leave AWT_S3_BUCKET empty to disable replication.
AWT_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
AWT_S3_BUCKET=awt-prod
# Everything this environment writes to the bucket goes under this prefix:
# the Litestream replica in <prefix>litestream/, uploads in <prefix>files/.
# prod/ works with one bucket shared with training (prefix training/ there) and with
# a bucket of its own; with a dedicated bucket it may also be left empty.
# Letters, digits, . _ - and single / only; the trailing / is optional.
AWT_BUCKET_PREFIX=prod/
AWT_S3_ACCESS_KEY=
AWT_S3_SECRET_KEY=
LITESTREAM_S3_REGION=gra
AWT_BLOB_BACKEND=s3

# Cloudflare cache purge when a flight is published.
AWT_CLOUDFLARE_ZONE_ID=
AWT_CLOUDFLARE_TOKEN=

# Manager MFA. Required once any manager has enrolled TOTP; generate with: openssl rand -base64 32
# Losing or changing it makes every enrolled TOTP secret unusable. Back it up with the other secrets.
AWT_MFA_KEY=
# WebAuthn relying party ID. Optional (default: host of AWT_BASE_URL). Must equal the site
# host or a parent domain of it; changing it invalidates every registered passkey.
AWT_WEBAUTHN_RP_ID=
