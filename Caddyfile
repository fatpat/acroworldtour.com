# Reverse proxy for prod and training. Hosts come from the environment
# (AWT_PROD_HOST, AWT_TRAINING_HOST, set in .env, see .env.example).
#
# Cloudflare ranges below are static (stock Caddy has no cloudflare
# trusted_proxies module). Refresh them from https://www.cloudflare.com/ips/
# when Cloudflare announces a change, and update the firewall the same way
# (docs/ops.md).
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

# Origin accepts Cloudflare only (the firewall does the same at the network
# level). Loopback stays allowed for checks run on the VPS itself.
(cloudflare_only) {
	@not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32 127.0.0.1/8 ::1
	abort @not_cloudflare
}

# SSE: no response buffering (flush every write) and no compression on the
# live stream.
(awt_proxy) {
	import cloudflare_only
	@live path /live/*
	@not_live not path /live/*
	encode @not_live zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy @live {args[0]} {
		flush_interval -1
		transport http {
			response_header_timeout 0
		}
	}
	reverse_proxy {args[0]}
}

{$AWT_PROD_HOST} {
	import awt_proxy awt-prod:8080
}

{$AWT_TRAINING_HOST} {
	import awt_proxy awt-training:8080
}
