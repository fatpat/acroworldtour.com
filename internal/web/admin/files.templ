package admin

import "awt/internal/web/layout"

templ filesPage(v filesView) {
	@layout.Admin(layout.Meta{Title: "Files", Heading: "Files"}, "files") {
		@notice(v.Flash)
		@errorSummary(v.Errors)
		<form class="card form" method="post" action="/manager/files" enctype="multipart/form-data">
			@csrf()
			<div class="field">
				<label for="file">Upload a PNG, JPEG, WebP or PDF (10 MB max)</label>
				<input id="file" name="file" type="file" accept="image/png,image/jpeg,image/webp,application/pdf" required/>
			</div>
			<button class="btn" type="submit">Upload</button>
		</form>
		<div class="table-wrap">
			<table class="table">
				<thead><tr><th>File</th><th>Type</th><th>Size</th><th>URL</th></tr></thead>
				<tbody>
					for _, f := range v.Files {
						<tr>
							<td><a href={ templ.SafeURL(fileURL(f)) }>{ f.Filename }</a></td>
							<td>{ f.ContentType }</td>
							<td>{ sizeLabel(f.Size) }</td>
							<td>
								<input class="copy-url" type="text" readonly value={ fileURL(f) } aria-label={ "URL of " + f.Filename } size="30"/>
								<button class="btn btn--ghost" type="button" data-copy>Copy</button>
							</td>
						</tr>
					}
					if len(v.Files) == 0 {
						<tr><td colspan="4">No file yet.</td></tr>
					}
				</tbody>
			</table>
		</div>
	}
}

func sizeLabel(n int64) string {
	switch {
	case n >= 1<<20:
		return ftoa(float64(n*10/(1<<20))/10) + " MB"
	case n >= 1<<10:
		return itoa(int(n>>10)) + " KB"
	}
	return itoa(int(n)) + " B"
}
