package admin

import (
	"awt/internal/domain"
	"awt/internal/web/layout"
)

templ runNewPage(v runNewView) {
	@layout.Admin(layout.Meta{Title: "New run", Heading: "New run, " + v.C.Name}, "competitions") {
		@errorSummary(v.Errors)
		<form class="card form" method="post" action={ templ.SafeURL(compHref(v.C) + "/runs") }>
			@csrf()
			<p class="field__hint">The starting order follows the competition order for the first run, then the current ranking (best flies last). The competition judges and settings are copied into the run.</p>
			@textField("qualify", "Participants to qualify (0 keeps everybody)", "number", v.Qualify, v.Errors, templ.Attributes{"min": "0", "required": true})
			<div class="field">
				<label for="reset_policy">Repetition reset policy</label>
				<select id="reset_policy" name="reset_policy">
					for _, o := range resetPolicies {
						<option value={ o.Value } selected?={ o.Value == v.Policy }>{ o.Label }</option>
					}
				</select>
				<p class="field__hint">Trick repetitions flown in previous runs count towards the repetition malus. The reset policy makes them start again from this run for the chosen pilots. Synchro competitions never reset.</p>
				@fieldError(v.Errors, "reset_policy")
			</div>
			<p class="actions">
				<button class="btn" type="submit">Create run</button>
				<a class="btn btn--ghost" href={ templ.SafeURL(compHref(v.C)) }>Cancel</a>
			</p>
		</form>
	}
}

templ startingOrder(v orderView) {
	<div id="starting-order">
		@errorSummary(v.Errors)
		<ol class="plain">
			for i, p := range v.Order {
				<li>
					<span class="num">{ itoa(p.Pos) }</span>
					{ p.Name }@awtStar(p.AWT)
					<span class="muted">{ p.Detail }</span>
					if v.CanEdit && v.Run.State != domain.RunClosed {
						<span class="actions">
							if i > 0 {
								@moveForm(v, p, "up", "Move up")
							}
							if i < len(v.Order)-1 {
								@moveForm(v, p, "down", "Move down")
							}
						</span>
					}
				</li>
			}
		</ol>
	</div>
}

templ moveForm(v orderView, p orderRow, dir, label string) {
	<form
		method="post"
		action={ templ.SafeURL(v.Href() + "/move") }
		hx-post={ v.Href() + "/move" }
		hx-target="#starting-order"
		hx-swap="outerHTML"
	>
		@csrf()
		<input type="hidden" name="id" value={ p.ID }/>
		<input type="hidden" name="dir" value={ dir }/>
		<button class="btn btn--ghost" type="submit" aria-label={ label + ": " + p.Name }>
			if dir == "up" {
				&#8593;
			} else {
				&#8595;
			}
		</button>
	</form>
}

templ runShowPage(v runView) {
	@layout.Admin(layout.Meta{Title: "Run " + itoa(v.N), Heading: v.C.Name + ", run " + itoa(v.N)}, "competitions") {
		@notice(v.Flash)
		<p>@stateBadge(string(v.Run.State)) <a href={ templ.SafeURL(compHref(v.C)) }>Back to the competition</a></p>
		if v.C.Frozen {
			@frozenNotice()
		}
		<p class="actions">
			if v.CanEdit {
				switch v.Run.State {
					case domain.RunInit:
						<a class="btn" href={ templ.SafeURL(v.Href() + "/state/open") }>Open run</a>
					case domain.RunOpen:
						<a class="btn" href={ templ.SafeURL(v.Href() + "/state/close") }>Close run</a>
					case domain.RunClosed:
						<a class="btn" href={ templ.SafeURL(v.Href() + "/state/reopen") }>Reopen run</a>
				}
			}
			<a class="btn btn--ghost" href={ templ.SafeURL(v.Href() + "/judging") }>Judging screen</a>
			<a class="btn btn--ghost" href={ templ.SafeURL(v.Href() + "/starting-order.html") }>Starting order (print)</a>
			<a class="btn btn--ghost" href={ templ.SafeURL(v.Href() + "/export/results.html") }>Run results (print)</a>
			<a class="btn btn--ghost" href={ templ.SafeURL(v.Href() + "/export/results.xlsx") }>Run CIVL xlsx</a>
		</p>
		<dl class="kv">
			<dt>Reset policy</dt><dd>{ resetLabel(int(v.Run.ResetPolicy)) }</dd>
			<dt>Participants</dt><dd>{ itoa(len(v.Order)) }</dd>
		</dl>
		<section class="section" id="order">
			<h2>Starting order</h2>
			if v.CanEdit && v.Run.State == domain.RunClosed {
				<p class="notice">The run is closed: reopen it to change the roster or the order.</p>
			}
			@startingOrder(orderView{C: v.C, Run: v.Run, Order: v.Order, CanEdit: v.CanEdit, Errors: sectionErrors(v, "order")})
		</section>
		<section class="section" id="judges">
			<h2>Judges of this run</h2>
			@errorSummary(sectionErrors(v, "judges"))
			<form class="card form" method="post" action={ templ.SafeURL(v.Href() + "/judges") }>
				@csrf()
				for _, j := range v.Judges {
					<div class="field field--check">
						<label>
							<input type="checkbox" name="judge" value={ j.J.ID } checked?={ j.Checked } disabled?={ !v.CanEdit }/>
							{ j.J.Name } ({ string(j.J.Level) })
						</label>
					</div>
				}
				if v.CanEdit {
					<p class="actions"><button class="btn" type="submit">Save run judges</button></p>
				}
			</form>
		</section>
		<section class="section" id="config">
			<details open?={ v.Section == "config" }>
				<summary>Run settings</summary>
				@configForm(v.Config, v.CanEdit)
			</details>
		</section>
	}
}

func sectionErrors(v runView, section string) formErrors {
	if v.Section == section {
		return v.Errors
	}
	return formErrors{}
}

