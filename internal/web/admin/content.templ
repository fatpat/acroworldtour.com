package admin

import "awt/internal/web/layout"

// mdField is a Markdown textarea with a live preview (htmx posts the text to
// /manager/content/preview and swaps the sanitised HTML in).
templ mdField(name, label, value string, fe formErrors) {
	<div class="field">
		<label for={ name }>{ label }</label>
		<textarea
			id={ name }
			name={ name }
			rows="18"
			hx-post="/manager/content/preview"
			hx-trigger="input changed delay:400ms, load"
			hx-target={ "#" + name + "-preview" }
			hx-swap="innerHTML"
			if fe.Msg(name) != "" {
				aria-invalid="true"
				aria-describedby={ name + "-error" }
			}
		>{ value }</textarea>
		<p class="field__hint">Markdown: # headings, **bold**, [links](https://...), ![alt](/files/ID), lists. Raw HTML is not rendered.</p>
		@fieldError(fe, name)
		<h3>Preview</h3>
		<div id={ name + "-preview" } class="card prose prose-preview" aria-live="polite"></div>
	</div>
}

templ previewFragment(html string) {
	@templ.Raw(html)
}

templ fileSelect(name, label, value, hint string, files []imageOption, fe formErrors) {
	<div class="field">
		<label for={ name }>{ label }</label>
		<select id={ name } name={ name }>
			<option value="">None</option>
			for _, f := range files {
				<option value={ f.ID } selected?={ f.ID == value }>{ f.Name }</option>
			}
		</select>
		if hint != "" {
			<p class="field__hint">{ hint }</p>
		}
		@fieldError(fe, name)
	</div>
}

templ contentHome(v contentHomeView) {
	@layout.Admin(layout.Meta{Title: "Content", Heading: "Website content"}, "content") {
		<ul class="plain-list">
			<li><a href="/manager/content/news">News</a> ({ itoa(v.News) })</li>
			<li><a href="/manager/content/events">Events</a> ({ itoa(v.Events) })</li>
			<li><a href="/manager/content/documents">Documents</a> ({ itoa(v.Documents) })</li>
			<li><a href="/manager/content/pages">Pages</a> ({ itoa(v.Pages) })</li>
			<li><a href="/manager/content/redirects">Redirects</a> ({ itoa(v.Redirects) })</li>
			<li><a href="/manager/content/settings">Home page and site settings</a></li>
		</ul>
	}
}

// ---- news ----

templ newsListPage(v newsListView) {
	@layout.Admin(layout.Meta{Title: "News", Heading: "News"}, "content") {
		@notice(v.Flash)
		<p><a class="btn" href="/manager/content/news/new">New article</a> <a class="btn btn--ghost" href="/manager/content">Content</a></p>
		<div class="table-wrap">
			<table class="table">
				<thead><tr><th>Title</th><th>Slug</th><th>Published</th><th></th></tr></thead>
				<tbody>
					for _, n := range v.Items {
						<tr>
							<td>{ n.Title }</td>
							<td><a href={ templ.SafeURL("/news/" + n.Slug) }>{ n.Slug }</a></td>
							<td>{ publishedLabel(n.PublishedAt) }</td>
							<td class="actions">
								<a class="btn btn--ghost" href={ templ.SafeURL("/manager/content/news/" + n.ID + "/edit") }>Edit</a>
								<a class="btn btn--ghost" href={ templ.SafeURL("/manager/content/news/" + n.ID + "/delete") }>Delete</a>
							</td>
						</tr>
					}
					if len(v.Items) == 0 {
						<tr><td colspan="4">No article yet.</td></tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ newsFormPage(v newsFormView) {
	@layout.Admin(layout.Meta{Title: "Article", Heading: formHeading(v.Form.ID, "article")}, "content") {
		@errorSummary(v.Errors)
		<form class="card form" method="post" action={ templ.SafeURL(formAction("/manager/content/news", v.Form.ID)) }>
			@csrf()
			@textField("title", "Title", "text", v.Form.Title, v.Errors, templ.Attributes{"required": true})
			@textField("slug", "Slug (URL part, derived from the title when empty)", "text", v.Form.Slug, v.Errors, templ.Attributes{"autocapitalize": "off"})
			@textField("author", "Author", "text", v.Form.Author, v.Errors, nil)
			@textField("published_at", "Publication date (empty keeps it a draft; a future date schedules it)", "date", v.Form.PublishedAt, v.Errors, nil)
			@textArea("excerpt", "Excerpt (teaser and meta description; derived from the text when empty)", v.Form.Excerpt, v.Errors, "")
			@fileSelect("cover", "Cover image", v.Form.Cover, "Upload images on the Files page first.", v.Images, v.Errors)
			@mdField("body_md", "Text", v.Form.BodyMD, v.Errors)
			<p class="actions">
				<button class="btn" type="submit">Save</button>
				<a class="btn btn--ghost" href="/manager/content/news">Cancel</a>
			</p>
		</form>
	}
}

// ---- events ----

templ eventsListPage(v eventsListView) {
	@layout.Admin(layout.Meta{Title: "Events", Heading: "Events"}, "content") {
		@notice(v.Flash)
		<p><a class="btn" href="/manager/content/events/new">New event</a> <a class="btn btn--ghost" href="/manager/content">Content</a></p>
		<div class="table-wrap">
			<table class="table">
				<thead><tr><th>Name</th><th>Season</th><th>Dates</th><th>Status</th><th></th></tr></thead>
				<tbody>
					for _, e := range v.Items {
						<tr>
							<td><a href={ templ.SafeURL("/event/" + e.Slug) }>{ e.Name }</a></td>
							<td>{ itoa(e.SeasonYear) }</td>
							<td>{ e.StartDate } – { e.EndDate }</td>
							<td>{ e.Status }</td>
							<td class="actions">
								<a class="btn btn--ghost" href={ templ.SafeURL("/manager/content/events/" + e.ID + "/edit") }>Edit</a>
								<a class="btn btn--ghost" href={ templ.SafeURL("/manager/content/events/" + e.ID + "/delete") }>Delete</a>
							</td>
						</tr>
					}
					if len(v.Items) == 0 {
						<tr><td colspan="5">No event yet.</td></tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ eventFormPage(v eventFormView) {
	@layout.Admin(layout.Meta{Title: "Event", Heading: formHeading(v.Form.ID, "event")}, "content") {
		@errorSummary(v.Errors)
		<form class="card form" method="post" action={ templ.SafeURL(formAction("/manager/content/events", v.Form.ID)) }>
			@csrf()
			@textField("name", "Name", "text", v.Form.Name, v.Errors, templ.Attributes{"required": true})
			@textField("slug", "Slug (derived from the name when empty; unique per season)", "text", v.Form.Slug, v.Errors, templ.Attributes{"autocapitalize": "off"})
			@textField("start_date", "Start date", "date", v.Form.StartDate, v.Errors, templ.Attributes{"required": true})
			@textField("end_date", "End date", "date", v.Form.EndDate, v.Errors, templ.Attributes{"required": true})
			@textField("season_year", "Season year (the start year when empty)", "number", v.Form.SeasonYear, v.Errors, templ.Attributes{"min": "1901", "max": "2999"})
			@textField("site", "Site", "text", v.Form.Site, v.Errors, nil)
			@textField("country", "Country (ISO 3166 alpha-3, e.g. fra)", "text", v.Form.Country, v.Errors, templ.Attributes{"maxlength": "3"})
			@textField("circuits", "Circuits (comma separated, e.g. AWT, AWQ)", "text", v.Form.Circuits, v.Errors, nil)
			<fieldset class="field">
				<legend>Disciplines</legend>
				@checkField("solo", "Solo", v.Form.Solo)
				@checkField("synchro", "Synchro", v.Form.Synchro)
				@fieldError(v.Errors, "disciplines")
			</fieldset>
			@selectField("status", "Status", v.Form.Status, eventStatusOptions, v.Errors)
			@fileSelect("cover", "Cover image", v.Form.Cover, "Upload images on the Files page first.", v.Images, v.Errors)
			@textField("website", "Official website", "url", v.Form.Website, v.Errors, nil)
			@textField("registration_url", "Registration URL", "url", v.Form.RegistrationURL, v.Errors, nil)
			@textField("civl_url", "CIVL URL", "url", v.Form.CivlURL, v.Errors, nil)
			@textField("live_stream_url", "Live stream URL", "url", v.Form.LiveStreamURL, v.Errors, nil)
			<div class="field">
				<label for="competitions">Linked competitions (results shown on the event page)</label>
				<select id="competitions" name="competitions" multiple size="6">
					for _, c := range v.Competitions {
						<option value={ c.ID } selected?={ v.Form.hasCompetition(c.ID) }>{ c.Name } ({ c.Code })</option>
					}
				</select>
				@fieldError(v.Errors, "competitions")
			</div>
			@mdField("description_md", "Description", v.Form.DescriptionMD, v.Errors)
			<p class="actions">
				<button class="btn" type="submit">Save</button>
				<a class="btn btn--ghost" href="/manager/content/events">Cancel</a>
			</p>
		</form>
	}
}

// ---- documents ----

templ documentsListPage(v documentsListView) {
	@layout.Admin(layout.Meta{Title: "Documents", Heading: "Documents"}, "content") {
		@notice(v.Flash)
		<p><a class="btn" href="/manager/content/documents/new">New document</a> <a class="btn btn--ghost" href="/manager/content">Content</a></p>
		<div class="table-wrap">
			<table class="table">
				<thead><tr><th>Title</th><th>Year</th><th>Category</th><th>File or URL</th><th></th></tr></thead>
				<tbody>
					for _, d := range v.Items {
						<tr>
							<td>{ d.Title }</td>
							<td>
								if d.Year != 0 {
									{ itoa(d.Year) }
								}
							</td>
							<td>{ d.Category }</td>
							<td>{ docTarget(d) }</td>
							<td class="actions">
								<a class="btn btn--ghost" href={ templ.SafeURL("/manager/content/documents/" + d.ID + "/edit") }>Edit</a>
								<a class="btn btn--ghost" href={ templ.SafeURL("/manager/content/documents/" + d.ID + "/delete") }>Delete</a>
							</td>
						</tr>
					}
					if len(v.Items) == 0 {
						<tr><td colspan="5">No document yet.</td></tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ documentFormPage(v documentFormView) {
	@layout.Admin(layout.Meta{Title: "Document", Heading: formHeading(v.Form.ID, "document")}, "content") {
		@errorSummary(v.Errors)
		<form class="card form" method="post" action={ templ.SafeURL(formAction("/manager/content/documents", v.Form.ID)) } enctype="multipart/form-data">
			@csrf()
			@textField("title", "Title", "text", v.Form.Title, v.Errors, templ.Attributes{"required": true})
			@textField("year", "Year (optional)", "number", v.Form.Year, v.Errors, templ.Attributes{"min": "1901", "max": "2999"})
			@textField("category", "Category (e.g. sporting-code, local-regulation)", "text", v.Form.Category, v.Errors, nil)
			<div class="field">
				<label for="file">PDF (10 MB max)</label>
				<input id="file" name="file" type="file" accept="application/pdf"/>
				if v.Form.FileID != "" {
					<p class="field__hint">Current file: <a href={ templ.SafeURL("/files/" + v.Form.FileID) }>{ shortID(v.Form.FileID) }</a>. Choose another PDF to replace it.</p>
				}
				@fieldError(v.Errors, "file")
			</div>
			@textField("url", "or an external URL", "url", v.Form.URL, v.Errors, nil)
			<p class="actions">
				<button class="btn" type="submit">Save</button>
				<a class="btn btn--ghost" href="/manager/content/documents">Cancel</a>
			</p>
		</form>
	}
}

// ---- pages ----

templ pagesListPage(v pagesListView) {
	@layout.Admin(layout.Meta{Title: "Pages", Heading: "Pages"}, "content") {
		@notice(v.Flash)
		<p><a class="btn" href="/manager/content/pages/new">New page</a> <a class="btn btn--ghost" href="/manager/content">Content</a></p>
		<div class="table-wrap">
			<table class="table">
				<thead><tr><th>Title</th><th>URL</th><th></th></tr></thead>
				<tbody>
					for _, p := range v.Items {
						<tr>
							<td>{ p.Title }</td>
							<td><a href={ templ.SafeURL("/" + p.Slug) }>{ "/" + p.Slug }</a></td>
							<td class="actions">
								<a class="btn btn--ghost" href={ templ.SafeURL("/manager/content/pages/" + p.Slug + "/edit") }>Edit</a>
								<a class="btn btn--ghost" href={ templ.SafeURL("/manager/content/pages/" + p.Slug + "/delete") }>Delete</a>
							</td>
						</tr>
					}
					if len(v.Items) == 0 {
						<tr><td colspan="3">No page yet.</td></tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ pageFormPage(v pageFormView) {
	@layout.Admin(layout.Meta{Title: "Page", Heading: formHeading(pageKey(v), "page")}, "content") {
		@errorSummary(v.Errors)
		<form class="card form" method="post" action={ templ.SafeURL(formAction("/manager/content/pages", pageKey(v))) }>
			@csrf()
			if v.Create {
				@textField("slug", "Slug (the page is served at /slug)", "text", v.Form.Slug, v.Errors, templ.Attributes{"required": true, "autocapitalize": "off"})
			} else {
				<p>URL: <code>{ "/" + v.Form.Slug }</code></p>
			}
			@textField("title", "Title", "text", v.Form.Title, v.Errors, templ.Attributes{"required": true})
			@mdField("body_md", "Text", v.Form.BodyMD, v.Errors)
			<p class="actions">
				<button class="btn" type="submit">Save</button>
				<a class="btn btn--ghost" href="/manager/content/pages">Cancel</a>
			</p>
		</form>
	}
}

// ---- redirects ----

templ redirectsPage(v redirectsView) {
	@layout.Admin(layout.Meta{Title: "Redirects", Heading: "Redirects"}, "content") {
		@notice(v.Flash)
		@errorSummary(v.Errors)
		<form class="card form" method="post" action="/manager/content/redirects">
			@csrf()
			@textField("from", "From path (e.g. /old-page)", "text", v.Form.From, v.Errors, templ.Attributes{"required": true, "autocapitalize": "off"})
			@textField("to", "To (a path or an https URL)", "text", v.Form.To, v.Errors, templ.Attributes{"required": true, "autocapitalize": "off"})
			@checkField("temporary", "Temporary (302) instead of permanent (301)", v.Form.Temporary)
			<button class="btn" type="submit">Save redirect</button>
		</form>
		<div class="table-wrap">
			<table class="table">
				<thead><tr><th>From</th><th>To</th><th>Type</th><th></th></tr></thead>
				<tbody>
					for _, r := range v.Items {
						<tr>
							<td><code>{ r.From }</code></td>
							<td><code>{ r.To }</code></td>
							<td>{ redirectKind(r.Permanent) }</td>
							<td>
								<form method="post" action="/manager/content/redirects/delete">
									@csrf()
									<input type="hidden" name="from" value={ r.From }/>
									<button class="btn btn--ghost" type="submit">Delete</button>
								</form>
							</td>
						</tr>
					}
					if len(v.Items) == 0 {
						<tr><td colspan="4">No redirect yet.</td></tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// ---- settings ----

templ settingsPage(v settingsView) {
	@layout.Admin(layout.Meta{Title: "Site settings", Heading: "Home page and site settings"}, "content") {
		@notice(v.Flash)
		@errorSummary(v.Errors)
		<form class="card form" method="post" action="/manager/content/settings">
			@csrf()
			@textField("hero_pre_title", "Hero: pre-title", "text", v.Form.HeroPreTitle, v.Errors, nil)
			@textField("hero_title", "Hero: title (default: Acro World Tour)", "text", v.Form.HeroTitle, v.Errors, nil)
			@textField("hero_subtitle", "Hero: subtitle (also the default meta description of the home page)", "text", v.Form.HeroSubtitle, v.Errors, nil)
			@fileSelect("hero_image", "Hero: background image", v.Form.HeroImage, "", v.Images, v.Errors)
			@textField("featured_video", "Featured YouTube video URL", "url", v.Form.FeaturedVideo, v.Errors, nil)
			@textField("featured_seasons", "Seasons whose top 5 shows on the home page (codes, comma separated, e.g. awt-2026, awq-2026)", "text", v.Form.FeaturedSeasons, v.Errors, nil)
			@textArea("default_description", "Default meta description", v.Form.DefaultDescription, v.Errors, "")
			@fileSelect("default_og_image", "Default social sharing image", v.Form.DefaultOGImage, "", v.Images, v.Errors)
			@textField("contact_email", "Contact email", "email", v.Form.ContactEmail, v.Errors, nil)
			<div class="field">
				<label for="sporting_code_document">Document linked as "Learn the rules"</label>
				<select id="sporting_code_document" name="sporting_code_document">
					<option value="">The FAI copy</option>
					for _, d := range v.Documents {
						<option value={ d.ID } selected?={ d.ID == v.Form.SportingCodeDoc }>{ d.Title }</option>
					}
				</select>
			</div>
			<p class="actions">
				<button class="btn" type="submit">Save</button>
				<a class="btn btn--ghost" href="/manager/content">Cancel</a>
			</p>
		</form>
	}
}
