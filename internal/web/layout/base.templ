package layout

import "awt/web/static"

// Base is the HTML shell: head (title, meta, Open Graph, icons, CSS), the
// CSRF wiring for htmx and the scripts.
templ Base(m Meta) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ m.fullTitle() }</title>
			if m.Description != "" {
				<meta name="description" content={ m.Description }/>
				<meta property="og:description" content={ m.Description }/>
			}
			if m.NoIndex {
				<meta name="robots" content="noindex, nofollow"/>
			}
			if m.Canonical != "" {
				<link rel="canonical" href={ m.Canonical }/>
				<meta property="og:url" content={ m.Canonical }/>
			}
			<meta property="og:site_name" content="Acro World Tour"/>
			<meta property="og:title" content={ m.fullTitle() }/>
			<meta property="og:type" content={ m.ogType() }/>
			if m.OGImage != "" {
				<meta property="og:image" content={ m.OGImage }/>
				<meta name="twitter:card" content="summary_large_image"/>
			}
			if csrfToken(ctx) != "" {
				<meta name="csrf-token" content={ csrfToken(ctx) }/>
			}
			<meta name="theme-color" content="#171717"/>
			<link rel="icon" href={ static.URL("img/favicon-32x32.png") } sizes="32x32" type="image/png"/>
			<link rel="icon" href={ static.URL("img/favicon-16x16.png") } sizes="16x16" type="image/png"/>
			<link rel="apple-touch-icon" href={ static.URL("img/apple-touch-icon.png") }/>
			<link rel="manifest" href={ static.URL("img/site.webmanifest") }/>
			<link rel="stylesheet" href={ static.URL("css/app.css") }/>
			<script src={ static.URL("vendor/htmx-2.0.4.min.js") } defer></script>
			<script src={ static.URL("vendor/htmx-ext-sse-2.2.2.js") } defer></script>
			<script src={ static.URL("js/app.js") } defer></script>
		</head>
		<body { htmxAttrs(ctx)... }>
			<a class="skip-link" href="#main">Skip to content</a>
			{ children... }
		</body>
	</html>
}
