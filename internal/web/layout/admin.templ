package layout

import (
	"awt/internal/auth"
	"awt/web/static"
)

type adminLink struct {
	Key, Label, Href string
	AdminOnly        bool
}

// adminNav is the back-office sidebar. Scorers only see Competitions; the
// rest is admin-only (spec 05, decision 0009).
var adminNav = []adminLink{
	{Key: "pilots", Label: "Pilots", Href: "/manager/pilots", AdminOnly: true},
	{Key: "teams", Label: "Teams", Href: "/manager/teams", AdminOnly: true},
	{Key: "judges", Label: "Judges", Href: "/manager/judges", AdminOnly: true},
	{Key: "tricks", Label: "Tricks", Href: "/manager/tricks", AdminOnly: true},
	{Key: "seasons", Label: "Seasons", Href: "/manager/seasons", AdminOnly: true},
	{Key: "competitions", Label: "Competitions", Href: "/manager/competitions"},
	{Key: "files", Label: "Files", Href: "/manager/files", AdminOnly: true},
	{Key: "users", Label: "Users", Href: "/manager/users", AdminOnly: true},
	{Key: "content", Label: "Content", Href: "/manager/content", AdminOnly: true},
}

func visibleAdminLinks(role string) []adminLink {
	var out []adminLink
	for _, l := range adminNav {
		if !l.AdminOnly || role == auth.RoleAdmin {
			out = append(out, l)
		}
	}
	return out
}

func current(on bool) string {
	if on {
		return "page"
	}
	return "false"
}

// Admin wraps a back-office page: top bar with the user menu, sidebar, main.
// It must run behind auth.RequireUser (the session comes from the context).
templ Admin(m Meta, active string) {
	{{ m.NoIndex = true }}
	{{ sess, hasSession := auth.SessionFromContext(ctx) }}
	@Base(m) {
		if !hasSession {
			// Rendered outside RequireUser: minimal shell, no user data.
			<main id="main" class="admin__main">
				<a href="/manager/login">Log in</a>
				{ children... }
			</main>
		} else {
			<div class="admin">
				<div class="admin__top">
					<a href="/manager"><img src={ static.URL("img/logo.svg") } alt="Acro World Tour admin" width="129" height="57"/></a>
					<div class="admin__user">
						<span>{ sess.User.Name } ({ sess.User.Role })</span>
						<form method="post" action="/manager/logout">
							<input type="hidden" name="_csrf" value={ sess.CSRF }/>
							<button class="btn btn--ghost" type="submit">Log out</button>
						</form>
					</div>
				</div>
				<aside class="admin__sidebar">
					<nav aria-label="Admin">
						<ul class="admin__nav">
							for _, l := range visibleAdminLinks(sess.User.Role) {
								<li><a href={ templ.SafeURL(l.Href) } aria-current={ current(l.Key == active) }>{ l.Label }</a></li>
							}
						</ul>
					</nav>
				</aside>
				<main id="main" class="admin__main">
					if m.Heading != "" {
						<h1>{ m.Heading }</h1>
					}
					{ children... }
				</main>
			</div>
		}
	}
}
